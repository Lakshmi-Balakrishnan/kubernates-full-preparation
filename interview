POD  -the three most common ways to create a Pod
1. Create a Pod directly (imperative command)
kubectl run nginx --image=nginx:latest
kubectl run webserver --image=httpd:latest     
verify :   kubectl get pods
kubectl get pod -o wide
kubectl describe pod nginx
kubectl exec -it nginx -- sh      # apt update ,apt install curl -y  ,curl localhost   For the Nginx image, use sh because many minimal images don't include bash.
----------------------------------------------------------------------------------------------------------------------------------

2. Generate YAML using --dry-run 
kubectl run mypod --image=nginx:latest --dry-run=client -o yaml > mypod.yaml
This does not create the Pod. It only generates the YAML file.

kubectl apply -f mypod.yaml

verify :  kubectl get pods
kubectl describe pod mypod
kubectl logs mypod
kubectl exec -it mypod -- sh 
---------------------------------------------------------------------------------------------------------------------------------------
3. Write the YAML manually
apiVersion: v1
kind: Pod
metadata:
  name: nginx
spec:
  containers:
    - name: nginx
      image: nginx:latest
      
 kubectl apply -f nginx.yaml
 
verify:  kubectl get pods
kubectl describe pod nginx
kubectl logs nginx
kubectl exec -it nginx -- sh
