HPA create deployment
----------------------------
#first check metric server 
kubectl get pod -n kube-system


apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: my-app
  template:
    metadata:
      labels:
        app: my-app
    spec:
      containers:
        - name: my-app
          image: nginx
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "257Mi"

Resource	            Meaning	                                    Example
CPU	               m means millicore	                            100m = 0.1 CPU
Memory	           Mi means mebibytes	                             128Mi
Memory	           Gi means gibibytes	                             1Gi
Requests	         Minimum resources  requested for scheduling	   100m, 128Mi
Limits	           Maximum resources the container can use	       500m, 257Mi
# service create 
kubectl expose deployment myapp --port=80

apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: hpa-app
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: my-app
  minReplicas: 2
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70

Step	          Command 	                                            Purpose
1	      kubectl apply -f my-app.yaml                    	          Create Deployment
2      	kubectl expose deployment my-app --port=80 --type=NodePort	Expose application
3	      kubectl apply -f hpa-app.yaml                            	  Create HPA
4	      kubectl get pods -n kube-system                          	  Inspect system Pods
5      	kubectl top pods	                                          Check resource usage
6     	kubectl get hpa --watch                                 	  Observe scaling

#pod
kubectl run load-generator \
  --image=busybox:1.36 \
  --restart=Never \
  -- /bin/sh -c "while true; do wget -q -O- http://my-app; done"

What each part means
Command	                            Purpose
kubectl run load-generator        	Creates a Pod named load-generator
--image=busybox:1.36              	Uses the BusyBox image
--restart=Never	                    Creates a standalone Pod
wget -q -O- http://my-app	          Sends HTTP requests to your Service and prints the response to standard output
while true	                        Repeats the requests continuously

